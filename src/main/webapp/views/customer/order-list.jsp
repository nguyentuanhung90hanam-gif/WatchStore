<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<main class="page-shell account-page"><jsp:include page="/views/shared/account-nav.jsp" /><section class="account-content"><div class="account-heading"><div><p class="eyebrow dark">LỊCH SỬ MUA HÀNG</p><h1>Đơn hàng của tôi</h1></div></div><div class="order-tabs"><button class="active">Tất cả</button><button>Chờ xác nhận</button><button>Đang giao</button><button>Hoàn thành</button><button>Đổi trả</button></div><div class="customer-orders"><c:forEach items="${orders}" var="order"><article><div class="order-head"><div><b>#${order.code}</b><small>${order.createdDate}</small></div><span class="status-badge ${order.statusEnum.cssClass}">${order.statusEnum.label}</span></div><div class="order-body" style="flex-direction:column; gap:10px; align-items:stretch;"><c:forEach var="item" items="${order.orderDetails}"><div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:5px;"><div style="display:flex; gap:10px; align-items:center;"><img src="${cp}/assets/images/watch-1.png" alt="" style="width:40px; height:40px; border-radius:4px; object-fit:cover;"><div><span style="font-weight:600; color:#334155; font-size:14px;">${item.productName} (${item.variantName})</span><div style="font-size:11px; color:#64748b;">Số lượng: ${item.quantity} | Giá: <fmt:formatNumber value="${item.price}" pattern="#,##0" />₫</div></div></div></div></c:forEach><div style="display:flex; justify-content:space-between; align-items:center; border-top:1px solid #f1f5f9; padding-top:10px; margin-top:5px;"><span style="font-size:13px; color:#64748b;">Tổng số tiền:</span><strong style="color:#0f172a; font-size:15px;"><fmt:formatNumber value="${order.totalAmount}" pattern="#,##0" />₫</strong></div></div><div class="order-actions"><a href="${cp}/orders/detail?code=${order.code}">Xem chi tiết</a><button data-demo-toast="Đã thêm sản phẩm vào giỏ">Mua lại</button></div></article></c:forEach></div></section></main>
