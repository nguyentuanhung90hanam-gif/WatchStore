<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<main class="page-shell account-page"><jsp:include page="/views/shared/account-nav.jsp" /><section class="account-content"><div class="account-heading"><div><p class="eyebrow dark">LỊCH SỬ MUA HÀNG</p><h1>Đơn hàng của tôi</h1></div></div><div class="order-tabs"><button class="active">Tất cả</button><button>Chờ xác nhận</button><button>Đang giao</button><button>Hoàn thành</button><button>Đổi trả</button></div><div class="customer-orders"><c:forEach items="${orders}" var="order"><article><div class="order-head"><div><b>#${order.code}</b><small>${order.createdAt}</small></div><span class="status-badge ${order.status.cssClass}">${order.status.label}</span></div><div class="order-body"><img src="${cp}/assets/images/watch-1.png" alt=""><div><b>Đồng hồ nam WatchStore</b><span>Số lượng: 1 · Biến thể tiêu chuẩn</span></div><strong><fmt:formatNumber value="${order.total}" pattern="#,##0" />₫</strong></div><div class="order-actions"><a href="${cp}/orders/detail?code=${order.code}">Xem chi tiết</a><button data-demo-toast="Đã thêm sản phẩm vào giỏ">Mua lại</button></div></article></c:forEach></div></section></main>
