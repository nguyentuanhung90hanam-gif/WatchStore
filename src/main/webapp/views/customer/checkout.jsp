<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<main class="page-shell checkout-page"><div class="checkout-steps"><span class="done">1 Giỏ hàng</span><i></i><span class="active">2 Thanh toán</span><i></i><span>3 Hoàn tất</span></div><form action="${cp}/orders/place" method="post" class="checkout-layout"><section><div class="checkout-card"><div class="card-heading"><span>01</span><div><h2>Thông tin nhận hàng</h2><p>Kiểm tra thông tin trước khi đặt đơn.</p></div></div><div class="form-grid two"><label>Họ và tên<input required value="${sessionScope.user.fullName}"></label><label>Số điện thoại<input required value="${sessionScope.user.phone}"></label><label class="full-field">Địa chỉ<input required value="Phường Nam Hoa Lư, tỉnh Ninh Bình"></label><label class="full-field">Ghi chú<textarea placeholder="Ghi chú cho nhân viên giao hàng"></textarea></label></div></div><div class="checkout-card"><div class="card-heading"><span>02</span><div><h2>Phương thức thanh toán</h2><p>Chọn phương thức phù hợp với bạn.</p></div></div><label class="payment-option selected"><input type="radio" name="payment" checked><span>▣</span><div><b>Thanh toán khi nhận hàng</b><small>Thanh toán bằng tiền mặt cho nhân viên giao hàng.</small></div></label><label class="payment-option"><input type="radio" name="payment"><span>▤</span><div><b>Chuyển khoản ngân hàng</b><small>Nhận thông tin chuyển khoản sau khi đặt hàng.</small></div></label><label class="payment-option"><input type="radio" name="payment"><span>◇</span><div><b>Thẻ tín dụng / ghi nợ</b><small>Visa, Mastercard và JCB.</small></div></label></div></section><aside class="order-summary checkout-summary"><h2>Đơn hàng của bạn</h2><c:forEach items="${cartItems}" var="item"><div class="checkout-product"><img src="${cp}/assets/images/${item.product.image}" alt=""><div><b>${item.product.name}</b><small>Số lượng: ${item.quantity}</small></div><span><fmt:formatNumber value="${item.lineTotal}" pattern="#,##0" />₫</span></div></c:forEach><p><span>Tạm tính</span><b><fmt:formatNumber value="${subtotal}" pattern="#,##0" />₫</b></p><p><span>Giảm giá</span><b>−<fmt:formatNumber value="${discount}" pattern="#,##0" />₫</b></p><p class="summary-total"><span>Tổng cộng</span><b><fmt:formatNumber value="${subtotal - discount + shipping}" pattern="#,##0" />₫</b></p><button class="button button-gold full">Đặt hàng</button><small>Bằng việc đặt hàng, bạn đồng ý với điều khoản mua hàng của WatchStore.</small></aside></form></main>
