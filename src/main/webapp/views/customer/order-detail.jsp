<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<main class="page-shell content-page order-detail"><div class="breadcrumbs"><a href="${cp}/orders/list">Đơn hàng</a><span>›</span><b>#${order.code}</b></div><div class="order-detail-head"><div><p class="eyebrow dark">MÃ ĐƠN #${order.code}</p><h1>Chi tiết đơn hàng</h1><span>Đặt lúc ${order.createdDate}</span></div><span class="status-badge ${order.statusEnum.cssClass}">${order.statusEnum.label}</span></div><section class="order-timeline"><div class="done"><i>✓</i><b>Đã đặt hàng</b><span>Hệ thống đã tiếp nhận</span></div><div class="done"><i>✓</i><b>Đã xác nhận</b><span>Đang chuẩn bị hàng</span></div><div class="${order.statusCode == 'SHIPPING' || order.statusCode == 'COMPLETED' ? 'done' : ''}"><i>3</i><b>Đang giao</b><span>Chờ cập nhật</span></div><div class="${order.statusCode == 'COMPLETED' ? 'done' : ''}"><i>4</i><b>Hoàn thành</b><span>Chờ cập nhật</span></div></section><div class="order-detail-grid"><section><article class="detail-card"><h2>Sản phẩm</h2><c:forEach var="item" items="${orderItems}"><div class="order-product" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px; padding-bottom:15px; border-bottom:1px solid #eee;"><div style="display:flex; gap:15px; align-items:center;"><img src="${cp}/assets/images/watch-1.png" alt="" style="width:65px; height:65px; border-radius:6px; object-fit:cover;"><div><b style="font-size:15px; color:#1e293b;">${item.productName} (${item.variantName})</b><div style="color:#64748b; font-size:12px; margin-top:2px;">Mã SP: ${item.sku} | Số lượng: ${item.quantity}</div><c:if test="${order.statusCode == 'COMPLETED'}"><a href="${cp}/page/reviews?productId=${item.productId}" class="button" style="display:inline-block; margin-top:6px; padding:4px 10px; background:#d97706; color:white; font-size:11px; font-weight:bold; border-radius:4px; text-decoration:none;">★ Viết đánh giá</a></c:if></div></div><strong style="color:#0f172a;"><fmt:formatNumber value="${item.lineTotal}" pattern="#,##0" />₫</strong></div></c:forEach></article><article class="detail-card"><h2>Địa chỉ nhận hàng</h2><b>${order.customerName}</b><p>${order.phone}</p><p>${order.shippingAddress}</p></article></section><aside class="detail-card payment-summary"><h2>Thanh toán</h2><p><span>Tạm tính</span><b><fmt:formatNumber value="${order.totalAmount}" pattern="#,##0" />₫</b></p><p><span>Phí vận chuyển</span><b>0₫</b></p><p class="summary-total"><span>Tổng cộng</span><b><fmt:formatNumber value="${order.totalAmount}" pattern="#,##0" />₫</b></p><span>Thanh toán khi nhận hàng</span><button class="button button-dark full" data-demo-toast="Đã gửi yêu cầu hỗ trợ">Yêu cầu hỗ trợ</button></aside></div></main>
